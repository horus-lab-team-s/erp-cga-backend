# Copier en .env — jamais versionné.
# Aucun secret ne doit figurer dans ce fichier d'exemple.

CGA_ENVIRONNEMENT=developpement

# Dossier du référentiel normatif. Par défaut Docs/referentiel/ à la racine du dépôt.
# CGA_DOSSIER_REFERENTIEL=../Docs/referentiel

# Origines autorisées pour le front. Format JSON.
CGA_ORIGINES_CORS=["http://localhost:3000"]

# ── À venir ──────────────────────────────────────────────────────────────────
# Les identifiants d'accès aux portails DGI et CNPS relèveront d'un coffre, pas
# d'une variable d'environnement. Voir Docs/architecture/05-securite-multitenant.md § 6.
# CGA_BASE_URL=postgresql+psycopg://utilisateur:motdepasse@localhost:5432/cga
